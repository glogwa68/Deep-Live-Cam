<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/surface">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Back"
            android:tint="@color/on_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Part Swap"
            android:textColor="@color/on_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/resetPointsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Reset Points"
            android:tint="@color/on_primary" />
    </LinearLayout>

    <!-- Source part preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/sourcePartContainer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/image_placeholder"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/sourcePartImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sourcePartPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Source\nPart"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source Image"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sourceInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to import the part to overlay"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectSourceButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Select"
            android:textSize="12sp"
            style="@style/RoundedButton"
            app:backgroundTint="@color/secondary" />
    </LinearLayout>

    <!-- Controls: Opacity and Feather -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Opacity"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/opacitySlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="100"
                android:stepSize="5"
                app:thumbColor="@color/secondary"
                app:trackColorActive="@color/secondary"
                app:trackColorInactive="@color/surface_variant" />

            <TextView
                android:id="@+id/opacityValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAlignment="textEnd" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Feather"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/featherSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="50"
                android:value="8"
                android:stepSize="1"
                app:thumbColor="@color/secondary"
                app:trackColorActive="@color/secondary"
                app:trackColorInactive="@color/surface_variant" />

            <TextView
                android:id="@+id/featherValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="8%"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAlignment="textEnd" />
        </LinearLayout>
    </LinearLayout>

    <!-- Target image with control point overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/card_background">

        <ImageView
            android:id="@+id/targetImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="2dp" />

        <!-- Preview of the warped result -->
        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:visibility="gone" />

        <!-- Touch point overlay for control points -->
        <com.deeplivecam.ui.TouchPointOverlay
            android:id="@+id/touchPointOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Placeholder -->
        <TextView
            android:id="@+id/targetPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Tap below to select target image\nThen drag the 4 points to position"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4" />
    </FrameLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectTargetButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Target"
            android:textSize="14sp"
            style="@style/RoundedOutlineButton"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Apply"
            android:textSize="14sp"
            style="@style/RoundedButton"
            app:backgroundTint="@color/secondary"
            android:layout_marginHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/savePartSwapButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Save"
            android:textSize="14sp"
            style="@style/RoundedButton"
            app:backgroundTint="@color/accent_green"
            android:layout_marginStart="6dp"
            android:enabled="false" />
    </LinearLayout>

    <!-- Progress -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/secondary"
        app:trackColor="@color/surface_variant" />

</LinearLayout>
